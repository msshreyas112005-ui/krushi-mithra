{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" }
  ],
  "redirects": [
    { "source": "/", "destination": "/index.html", "permanent": false },
    { "source": "/frontend/html/:path*", "destination": "/html/:path*", "permanent": false },
    { "source": "/frontend/css/:path*", "destination": "/css/:path*", "permanent": false },
    { "source": "/frontend/js/:path*", "destination": "/js/:path*", "permanent": false },
    { "source": "/frontend/languages/:path*", "destination": "/languages/:path*", "permanent": false }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization" }
      ]
    }
  ]
}
